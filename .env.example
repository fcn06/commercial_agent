# ═══════════════════════════════════════════════════════════
#  Commercial B2B Agent Environment Configuration (.env.example)
# ═══════════════════════════════════════════════════════════

# Edition
EDITION=professional

# Global NATS Message Bus
NATS_URL=nats://127.0.0.1:4222

# Public Gateway
GATEWAY_URL=http://127.0.0.1:3002
GATEWAY_PORT=3002

# Agent / MCP Endpoints
SSI_AGENT_ENDPOINT=http://127.0.0.1:8082
CONNECTOR_MCP_URL=http://127.0.0.1:3050
VP_MCP_URL=http://127.0.0.1:4000

# WebSockets
GATEWAY_WS_URL=ws://127.0.0.1:3002/ws/wallet

# OpenID4VP JWT Signing Key (Development ONLY)
OID4VP_CLIENT_ID="<YOUR-SECRET-OID4VP-CLIENT-ID>"
OID4VP_RSA_PEM="<YOUR-SECRET-RSA-PEM-PRIVATE-KEY>"

# Google OAuth
GOOGLE_CLIENT_ID="<YOUR-SECRET-GOOGLE-CLIENT-ID>"
GOOGLE_CLIENT_SECRET="<YOUR-SECRET-GOOGLE-CLIENT-SECRET>"
GOOGLE_REDIRECT_URI="http://localhost:3060/oauth/google/callback"

# Swarm Gateway (Tier 1 Cognitive Ingress)
SWARM_GATEWAY_URL="http://127.0.0.1:8080"
SWARM_GATEWAY_TOKEN="<YOUR-SECRET-SWARM-GATEWAY-TOKEN>"
SWARM_COGNITIVE_FORMAT="responses"
SWARM_MODEL_ID="openai/gpt-oss-20b"

# Marketplace Trust Gateway (Tier 2 Execution Egress)
TRUST_GATEWAY_URL="http://127.0.0.1:8081"
JWT_SECRET="<YOUR-SECRET-JWT>"
B2B_JWT_SECRET="<YOUR-SECRET-B2B-JWT>"

# Dynamic skill filtering
DEFAULT_TOOLS="search_skills,switch_context,list_bundles,read_skill,vp_search,claw_weather,claw_extract_content_from_url,claw_hello_world,inspect_schema,compute_statistics,detect_anomalies,generate_markdown,join_datasets,sample_rows,discover_agent_services,google_calendar_create_event,google_calendar_list_events,call_b2b_agent,register_b2b_agent,list_registered_b2b_agents,discover_b2b_agents,reputation_inspect_counterparty,contract_propose_or_amend,contract_verify_and_activate,receipt_present_and_store"

# Cloudflare Analytics
# CLOUDFLARE_BEACON_TOKEN="<YOUR-SECRET-CLOUDFLARE-BEACON-TOKEN>"

# B2B OAuth Configuration
B2B_IDENTITY_SERVER_URL=http://127.0.0.1:4012
B2B_JWKS_URL=http://127.0.0.1:4012/.well-known/jwks.json

# B2B OAuth Client Secrets
B2B_SECRET_COMPANY_ALPHA="<YOUR-SECRET-COMPANY-ALPHA>"
B2B_SECRET_COMPANY_BETA="<YOUR-SECRET-COMPANY-BETA>"
B2B_SECRET_COMPANY_GAMMA="<YOUR-SECRET-COMPANY-GAMMA>"
B2B_SECRET_COMPANY_DELTA="<YOUR-SECRET-COMPANY-DELTA>"
B2B_SECRET_COMPANY_EPSILON="<YOUR-SECRET-COMPANY-EPSILON>"
